# Lane worktrees for racing-code runs.
# This repository uses `laneDir: branch` (see doc/racing-code.md), so its lanes live in
# racing/<lane-id>/ at the project root — outside every worktree, nothing to ignore.
# The entry below is for the default `laneDir` mode, kept for normal repositories.
.worktrees/

# local scratch: temporary scripts/analysis (see the temporary-scripts skill)
.script/

# dependencies and packaging leftovers
node_modules/
*.tgz
npm-debug.log*

# OS noise
.DS_Store
